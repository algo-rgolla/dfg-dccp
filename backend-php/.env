# App
APP_ENV=local
APP_DEBUG=1
APP_DEBUG_LOG_ENABLED=1

# Sessions (keep these EXACT during setup)
APP_SESSION_NAME=CCPORTALSESSID
APP_COOKIE_PATH=/
APP_SESSION_PREFIX=ccportal

# Database (keep your current values)
DB_SERVER=<<<db_server>>>
DB_HOST=<<<db_host>>>
DB_DATABASE=CCPortal
DB_USERNAME=<<<db_user>>>
DB_PASSWORD=<<<db_password>>>
DB_PORT=<<<db_port>>>
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_LOGIN_TIMEOUT=5

# CAPS database (2nd connection)
CAPS_DB_SERVER=<<<caps_Server>>>
CAPS_DB_DATABASE=CAPS
CAPS_DB_USERNAME=<<<caps_db_user>>>
CAPS_DB_PASSWORD=<<<caps_db_password>>>
CAPS_DB_ENCRYPT=true
CAPS_DB_TRUST_CERT=true
CAPS_DB_LOGIN_TIMEOUT=5
CAPS_DB_PORT=<<<caps_db_port>>>

LOGIN_AUTH_MODE=windows


DEV_WINDOWS_ENABLED=false
ONBOARDING_SHOW_ACTIVATION_URL=true
ONBOARDING_DEFAULT_ROLE=User



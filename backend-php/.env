# App
APP_ENV=local
APP_DEBUG=1
APP_DEBUG_LOG_ENABLED=1

# Sessions (keep these EXACT during setup)
APP_SESSION_NAME=CCPORTALSESSID
APP_COOKIE_PATH=/
APP_SESSION_PREFIX=ccportal

# Database (local SQL Server, Windows integrated auth: leave USERNAME/PASSWORD empty)
DB_SERVER=(local)
DB_HOST=(local)
DB_DATABASE=CCPortal
DB_USERNAME=
DB_PASSWORD=
DB_PORT=
DB_ENCRYPT=false
DB_TRUST_CERT=false
DB_LOGIN_TIMEOUT=5

# CAPS database (2nd connection)
CAPS_DB_SERVER=(local)
CAPS_DB_DATABASE=CAPS
CAPS_DB_USERNAME=
CAPS_DB_PASSWORD=
CAPS_DB_ENCRYPT=false
CAPS_DB_TRUST_CERT=false
CAPS_DB_LOGIN_TIMEOUT=5
CAPS_DB_PORT=

LOGIN_AUTH_MODE=windows


DEV_WINDOWS_ENABLED=true
DEV_WINDOWS_LOGIN=ravi-caps
ONBOARDING_SHOW_ACTIVATION_URL=true
ONBOARDING_DEFAULT_ROLE=User


